{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "english-listening",
  "main": "worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
